{
  "name": "@farrier/conductor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "farrier-conductor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test --test-reporter=dot 'dist/**/*.test.js'",
    "spawn": "tsx src/cli.ts spawn",
    "follow-up": "tsx src/cli.ts follow-up",
    "status": "tsx src/cli.ts status",
    "prs": "tsx src/cli.ts prs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.26"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
